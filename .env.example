# Credenciais opcionais para ativar dados 100% ao vivo.
# Sem essas variáveis o dashboard funciona normalmente com o modo
# de simulação realista (determinística por hora).

# TikTok Shop Partner API - https://partner.tiktokshop.com
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=

# Shopee Open Platform - https://open.shopee.com
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=

# Mercado Livre API - https://developers.mercadolivre.com.br
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_ACCESS_TOKEN=

# Google Trends já funciona ao vivo sem chave (feed RSS público do Google).
