# Credenciais opcionais para ativar dados 100% ao vivo.
# Sem essas variáveis o dashboard funciona normalmente com o modo
# de simulação realista (determinística por hora).

# TikTok Shop Partner API - https://partner.tiktokshop.com
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_ACCESS_TOKEN=

# Shopee Open Platform - https://open.shopee.com
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=

# Mercado Livre API - https://developers.mercadolivre.com.br
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_ACCESS_TOKEN=

# Google Trends já funciona ao vivo sem chave (feed RSS público do Google).

# X / Twitter API v2 - https://developer.x.com/en/portal/dashboard
X_BEARER_TOKEN=

# YouTube Data API - https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Pinterest API - https://developers.pinterest.com
PINTEREST_ACCESS_TOKEN=

# Google Analytics 4 Data API - exige também credenciais OAuth/service account
GOOGLE_ANALYTICS_PROPERTY_ID=

# Google Search Console API - exige também credenciais OAuth/service account
GOOGLE_SEARCH_CONSOLE_SITE_URL=
